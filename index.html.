<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Аня, с днём рождения</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marck+Script&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--night:#170c16;--plum:#3a1730;--rose:#eaa9b6;--cream:#f7ebdf;--gold:#d2a86e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:radial-gradient(ellipse at 50% 0%,var(--plum),var(--night) 75%) fixed,var(--night);color:var(--cream);font-family:Lora,Georgia,serif;line-height:1.7}
main{max-width:34rem;margin:0 auto;padding:0 1.25rem 4rem;text-align:center}
.hero{min-height:92vh;min-height:92svh;display:flex;flex-direction:column;justify-content:center;align-items:center}
.hero h1{font-family:'Marck Script',cursive;font-weight:400;font-size:clamp(2.6rem,11vw,3.6rem);line-height:1.1;margin:0 0 .4rem}
.hero .age{font-family:'Marck Script',cursive;font-size:7rem;line-height:1;color:var(--rose);margin:0 0 1.5rem}
.candle{appearance:none;background:none;border:0;color:inherit;font:inherit;cursor:pointer;padding:.5rem 1rem}
.cake{width:6.5rem;margin:0 auto .6rem;display:block}
.flame{transform-origin:50% 100%;animation:flick 1.1s ease-in-out infinite alternate}
@keyframes flick{from{transform:scale(1,1) rotate(-3deg)}to{transform:scale(.92,1.1) rotate(3deg)}}
.out .flame{display:none}
.hint{color:var(--rose);font-style:italic;margin:0}
.candle:focus-visible,.btn:focus-visible{outline:2px solid var(--gold);outline-offset:6px;border-radius:.5rem}
.rest{display:none}
.rest.on{display:block;animation:rise 1.1s ease both}
@keyframes rise{from{opacity:0;transform:translateY(1.2rem)}to{opacity:1;transform:none}}
.letter{text-align:left;background:#f7ebdf;color:#4a1f2e;padding:2rem 1.6rem;border-radius:.3rem;box-shadow:0 1.5rem 3rem rgba(0,0,0,.5);margin:0 0 3.5rem}
.letter h2{font-family:'Marck Script',cursive;font-weight:400;font-size:2.4rem;margin:0 0 .5rem}
.letter p{font-size:1.04rem;margin:0 0 1.1rem}
.letter .sign{font-family:'Marck Script',cursive;font-size:1.9rem;text-align:right;margin:1.4rem 0 0}
figure{margin:0 auto 3.5rem;max-width:22rem;background:#f7ebdf;padding:.7rem .7rem 0;border-radius:.2rem;box-shadow:0 1.2rem 2.5rem rgba(0,0,0,.5)}
figure.a{transform:rotate(-2deg)}figure.b{transform:rotate(1.5deg)}
figure img{display:block;width:100%;height:auto;border-radius:.1rem}
figcaption{font-family:'Marck Script',cursive;color:#4a1f2e;font-size:1.45rem;line-height:1.3;padding:.8rem .4rem 1rem}
.end{font-family:'Marck Script',cursive;font-size:2.2rem;line-height:1.3;color:var(--rose);margin:0}
canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none}
@media (prefers-reduced-motion:reduce){.flame{animation:none}.rest.on{animation:none}}
</style></head><body>
<main>
<section class="hero">
  <h1>аня, с днём рождения!</h1>
  <div class="age" aria-label="Семнадцать">17</div>
  <button class="candle" id="candle" aria-label="Задуть свечу">
    <svg class="cake" viewBox="0 0 100 120" aria-hidden="true">
      <g class="flame"><path d="M50 8c8 12 12 18 6 28-3 5-9 5-12 0-6-10 0-16 6-28z" fill="#ffc46b"/><path d="M50 22c4 6 5 9 2 14-1.5 2.5-4.5 2.5-5 0-1-4 1-6 3-14z" fill="#ff8a4c"/></g>
      <rect x="47" y="38" width="6" height="26" rx="2" fill="#f7ebdf"/>
      <rect x="12" y="64" width="76" height="46" rx="8" fill="#eaa9b6"/>
      <path d="M12 80q10 10 19 0t19 0 19 0 19 0v-8a8 8 0 0 0-8-8H20a8 8 0 0 0-8 8z" fill="#f7ebdf"/>
    </svg>
    <p class="hint" id="hint">загадай желание и нажми на свечу</p>
  </button>
</section>

<div class="rest" id="rest">
  <article class="letter">
    <h2>аня,</h2>
    <p>мы вместе почти семь месяцев а я до сих пор помню нашу первую встречу, твой взгляд и твои красивые глаза, и сразу как будто искра</p>
    <p>за эти месяцы я понял за что тебя люблю, за то что ты настоящая, за глаза в которые хочется смотреть долго, за твой запах который невозможно перепутать, за улыбку которая цепляет и остаётся в голове, и за то что с тобой можно дурачиться как угодно, даже когда доходит до плевков в лицо, это тоже по-своему мило</p>
    <p>пусть этот год будет тёплым, громким и лёгким, с цветами и с людьми которым рядом с тобой хорошо, а я буду рядом</p>
    <p class="sign">твой никита</p>
  </article>

  <figure class="a"><img src="data:image/jpeg;base64," alt="Аня и Никита рядом на тёмном фото"><figcaption>света мало а тепло всё равно видно</figcaption></figure>

  <figure class="b"><img src="data:image/jpeg;base64," alt="Кот с подписью «фу покажи»"><figcaption>я когда ты говоришь «сейчас кое-что покажу»</figcaption></figure>

  <p class="end">с днём рождения, моя аня ♥</p>
</div>
</main>
<canvas id="fx" aria-hidden="true"></canvas>
<script>
var done=false;
document.getElementById('candle').addEventListener('click',function(){
  if(done)return;done=true;
  this.classList.add('out');
  document.getElementById('hint').textContent='желание принято, теперь читай';
  var r=document.getElementById('rest');r.classList.add('on');
  setTimeout(function(){r.scrollIntoView({behavior:'smooth',block:'start'})},500);
  petals();
});
function petals(){
  var c=document.getElementById('fx'),g=c.getContext('2d'),d=devicePixelRatio||1,list=[],t0=performance.now();
  function fit(){c.width=innerWidth*d;c.height=innerHeight*d}fit();addEventListener('resize',fit);
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  for(var i=0;i<60;i++)list.push({x:Math.random()*c.width,y:-Math.random()*c.height*.8,s:(7+Math.random()*9)*d,v:(.8+Math.random()*1.4)*d,w:Math.random()*6,a:Math.random()*6});
  function frame(now){
    g.clearRect(0,0,c.width,c.height);
    var fade=Math.max(0,1-(now-t0-9000)/3000);
    if(fade<=0){g.clearRect(0,0,c.width,c.height);return}
    list.forEach(function(p){
      if(!reduce){p.y+=p.v;p.w+=.025;p.a+=.03}
      var x=p.x+Math.sin(p.w)*20*d,y=reduce?c.height*.3+p.y%(c.height*.5):p.y;
      g.save();g.translate(x,y);g.rotate(p.a);g.globalAlpha=.85*fade;g.fillStyle='#eaa9b6';
      g.beginPath();g.ellipse(0,0,p.s*.5,p.s,0,0,6.283);g.fill();g.restore();
    });
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}
</script></body></html>
